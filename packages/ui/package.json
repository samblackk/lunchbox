{
  "name": "@neonanomaly/lunchbox",
  "version": "0.0.0",
  "description": "Component library for Neon Anomaly properties.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/rollup-plugin": "^1.5.4",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
